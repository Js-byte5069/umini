{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "eden/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/chat",
      "dest": "index.js"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/eden/?",
      "dest": "/eden/index.html"
    },
    {
      "src": "/eden/(.*)",
      "dest": "/eden/$1"
    }
  ]
}